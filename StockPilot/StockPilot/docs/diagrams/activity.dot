S[shape=circle,label="",style=filled,fillcolor=black,width=.25]; E[shape=doublecircle,label="",style=filled,fillcolor=black,width=.2];
A1[label="Staff logs in"]; A2[label="Enter SKU & quantity\n(add to cart)"]; A3[shape=diamond,style="",label="Stock\nsufficient?"];
